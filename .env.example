GEMINI_API_KEY=
CONTEXT_DEV_API_KEY=

# Verified via official @google/genai gemini-api-dev skill:
# - gemini-4-hydrogen (default fast daily driver; recommended replacement for gemini-3.8-flash)
# - gemini-3.5-flash-lite (ultra-fast, low-latency Flash-Lite)
# - gemini-4-carbon (configurable flagship / Pro-tier reasoning model)
# - gemini-3.8-flash (supported active legacy model)
GEMINI_MODEL=gemini-4-hydrogen
GEMINI_PRO_MODEL=gemini-4-carbon

# Optional future multimodal hooks (verified current IDs)
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
GEMINI_VIDEO_MODEL=gemini-omni-1.2-flash

PORT=3001
